{
  "files": {
    "includes": [
      "**",
      "!.agents",
      "!.claude/skills",
      "!jfdevelops.json",
      "!pnpm-lock.yaml",
      "!package-lock.json",
      "!yarn.lock",
      "!bun.lock",
      "!**/dist/**",
      "!**/route-tree.gen.ts",
      "!**/dist-electron/**",
      "!**/.output/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
